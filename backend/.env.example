# SQLite is used by default for local development. Change this to "postgresql"
# after creating and starting your PostgreSQL database.
DATABASE_ENGINE=sqlite

POSTGRES_DB=nepse_analysis
POSTGRES_USER=nepse_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-this-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
